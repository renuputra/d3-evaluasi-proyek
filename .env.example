# Nilai bawaan aplikasi. Salin ke .env hanya bila ingin mengubah (file .env jangan di-commit).
# Semua nilai di sini fiktif / untuk uji lokal.
PORT=3003
# Alamat layanan kelompok lain. Bawaan: mock lokal pada port MOCK_PORT.
F1_BASE_URL=http://localhost:4010
D1_BASE_URL=http://localhost:4010
E5_BASE_URL=http://localhost:4010
# true = jalankan mock F-1, D-1, dan E-5 di proses yang sama. Ganti false bila memakai layanan nyata.
START_MOCK=true
MOCK_PORT=4010
